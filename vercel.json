{
  "rewrites": [
    { "source": "/es", "destination": "/es.html" },
    { "source": "/prelanzamiento", "destination": "/es.html" },
    { "source": "/pt", "destination": "/pt.html" },
    { "source": "/prelancamento", "destination": "/pt.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
